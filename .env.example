# Copy to .env for local development. On Railway set these as service Variables.
# Never commit real values.

# --- External APIs ---
EVERTRACE_API_KEY=
ROCKETREACH_API_KEY=
AFFINITY_API_KEY=

# --- Database --- (local default is SQLite; Railway injects DATABASE_URL for Postgres)
DATABASE_URL=sqlite:///./origination.db

# --- Dashboard auth ---
# Generate with: uv run python -m app.jobs.hash_password
ADMIN_PASSWORD_HASH=
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Same value on web and cron; never rotate it (keys the erasure-suppression hashes).
SUPPRESSION_SECRET=

# --- Behaviour ---
APP_ENV=development
ROCKETREACH_DAILY_CAP=40
AFFINITY_ORIGINATION_LIST_ID=123879
AFFINITY_APPLICANT_LIST_ID=310945
DSW_EMAIL_DOMAINS=dsw.vc
FOLLOW_UP_AFTER_DAYS=14
# Proxies in front of the web service that append to X-Forwarded-For (Railway: 1).
TRUSTED_PROXY_HOPS=1
